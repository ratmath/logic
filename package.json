{
  "name": "@ratmath/logic",
  "version": "0.2.0",
  "description": "Formal logic for RatMath: propositional and predicate logic, proof checking, model search, modal logic and computability",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/llms.txt"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "bun test ./tests",
    "docs:build": "bun scripts/build-docs.js && node scripts/build-llms.mjs",
    "docs:llms": "node scripts/build-llms.mjs"
  },
  "keywords": [
    "logic",
    "propositional",
    "predicate",
    "proof",
    "satisfiability",
    "exact",
    "ratmath"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ratmath/logic.git"
  },
  "homepage": "https://ratmath.com/logic/",
  "bugs": {
    "url": "https://github.com/ratmath/logic/issues"
  },
  "peerDependencies": {
    "@ratmath/core": ">=0.12.0"
  },
  "devDependencies": {
    "@ratmath/core": "^0.12.0",
    "katex": "0.19.1"
  },
  "types": "index.d.ts",
  "author": "James Taylor",
  "engines": {
    "node": ">=22",
    "bun": ">=1.4.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
